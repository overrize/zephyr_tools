{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zephyr Tools",
  "version": "0.2.0",
  "identifier": "com.zephyrtools.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Zephyr Tools",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
